# =====================================================================
# AI Office — 환경변수 예시
# 로컬: 이 파일을 .env.local 로 복사해서 값을 채우세요.  (cp .env.example .env.local)
# Vercel: Project Settings → Environment Variables 에 같은 이름으로 등록하세요.
# NEXT_PUBLIC_ 으로 시작하는 값만 브라우저에 노출됩니다. 나머지는 서버 전용입니다.
# =====================================================================

# ---- Supabase (필수) ------------------------------------------------
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — 레거시 anon key 를 써도 됩니다 (NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) — 레거시 service_role key 도 가능 (SUPABASE_SERVICE_ROLE_KEY). 절대 클라이언트에 노출 금지
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---- App (필수) -----------------------------------------------------
# 배포 URL (이메일 인증 링크, OAuth redirect 에 사용)
APP_URL=http://localhost:3000
# Notion 토큰 암호화 / OAuth state 서명용. 32자 이상 랜덤 문자열 권장
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Cron 엔드포인트 보호용 (Vercel Cron 은 Authorization: Bearer <CRON_SECRET> 를 자동으로 붙임)
CRON_SECRET=

# ---- OpenAI (AI 업무 실행에 필수) -----------------------------------
OPENAI_API_KEY=
# 직급별 기본 모델 (직원 상세 화면에서 직원마다 덮어쓸 수 있음)
#   junior   = Intern / Associate
#   senior   = Senior / Manager
#   executive= Director / Executive
AI_MODEL_JUNIOR=gpt-5-mini
AI_MODEL_SENIOR=gpt-5-mini
AI_MODEL_EXECUTIVE=gpt-5
# (선택) 모델 가격 덮어쓰기 (USD / 1M tokens)
# AI_PRICING_JSON={"gpt-5":{"input":1.25,"cachedInput":0.125,"output":10}}
# (선택) 웹 검색 1회당 추정 비용 (USD)
AI_WEB_SEARCH_COST_PER_CALL=0.01

# ---- 검색 Adapter ---------------------------------------------------
# openai: OpenAI 내장 web_search tool 사용 (기본)
# tavily: Tavily Search API 로 먼저 검색 후 결과를 UNTRUSTED_EXTERNAL_CONTENT 로 전달
SEARCH_PROVIDER=openai
TAVILY_API_KEY=

# ---- Notion (선택) --------------------------------------------------
# 방법 A) OAuth (Public Integration) — 권장
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:3000/api/notion/oauth/callback
# 방법 B) 서버 공용 Internal Integration Token (1인 사용 / 셀프호스팅)
NOTION_TOKEN=
# AI OFFICE 페이지를 만들 상위 페이지 URL 또는 ID
NOTION_PARENT_PAGE_ID=
# 방법 C) 앱의 Notion 화면에서 회사별 Integration Token 을 직접 입력 (환경변수 불필요)
